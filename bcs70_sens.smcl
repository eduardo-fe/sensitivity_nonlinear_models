{com}. *===============================================================================
. * sensitivity_profile
. *
. * Standalone diagnostic tool for the synthetic confounder sensitivity
. * analysis. For a FIXED rho_Y, sweeps rho_D across the feasible interval
. * on a fine grid, computes the adjusted AME and t-statistic at each point,
. * and produces a two-panel graph showing:
. *   - Top panel: adjusted AME as a function of rho_D, with a horizontal
. *     line at AME = 0 (sign-change reference).
. *   - Bottom panel: |t|-statistic as a function of rho_D, with a
. *     horizontal line at z_{c -(}alpha/2{c )-} (explain-away reference).
. *
. * Threshold crossings are visible as the points where the AME curve
. * crosses zero (sign change) and where the |t| curve crosses the
. * critical value (explain away).
. *
. * REQUIRES: sens_abc, sens_build_z, sens_fit from the sensitivity package.
. *   Run/load the main sensitivity_v18.do file first, or paste the three
. *   helper programs (sens_abc, sens_build_z, sens_fit) before this file.
. *
. * SYNTAX:
. *   sensitivity_profile Y D [X1 X2 ...], model(string) rhoy(real)
. *       [ngrid(integer 201) seed(integer 12345) level(real 95)
. *        baseoutcome(integer 1) outcome(string) atmeans
. *        saving(string) replace scanmargin(real 0.005)]
. *
. * EXAMPLES:
. *   sensitivity_profile Y D X1 X2, model(logit) rhoy(0.3)
. *   sensitivity_profile Y D X1 X2, model(logit) rhoy(0.3) ngrid(501)
. *   sensitivity_profile Y D X1 X2, model(mlogit) rhoy(0.3) ///
> *       baseoutcome(1) outcome(2)
. *   sensitivity_profile Y D X1 X2, model(logit) rhoy(0.3) ///
> *       saving(profile_ry03) replace
. *
. *===============================================================================
. 
. capture program drop sensitivity_profile
{txt}
{com}. program define sensitivity_profile, rclass
{txt}  1{com}.     syntax varlist(min=2) [if] [in],  ///
>         Model(string)                 ///
>         RHOY(real)                    ///
>         [ NGRid(integer 201)          ///
>           seed(integer 12345)         ///
>           ATMeans                     ///
>           BASEoutcome(integer 1)      ///
>           Level(real 95)              ///
>           outcome(string)             ///
>           saving(string)              ///
>           replace                     ///
>           SCANMargin(real 0.005) ]
{txt}  2{com}. 
.     marksample touse
{txt}  3{com}. 
.     gettoken Y varlist : varlist
{txt}  4{com}.     gettoken D rest    : varlist
{txt}  5{com}.     local X "`rest'"
{txt}  6{com}. 
.     local model = lower("`model'")
{txt}  7{com}.     if !inlist("`model'","logit","probit","cloglog","poisson", ///
>                          "nbreg","ologit","mlogit") {c -(}
{txt}  8{com}.         di as error "Unsupported model: `model'"
{txt}  9{com}.         exit 198
{txt} 10{com}.     {c )-}
{txt} 11{com}. 
.     if "`model'" == "mlogit" & "`outcome'" == "" {c -(}
{txt} 12{com}.         di as error "mlogit requires outcome() option"
{txt} 13{com}.         exit 198
{txt} 14{com}.     {c )-}
{txt} 15{com}. 
.     global sens_X "`X'"
{txt} 16{com}. 
.     local alpha = 1 - `level'/100
{txt} 17{com}.     local z     = invnormal(1 - `alpha'/2)
{txt} 18{com}.     local atm   = 0
{txt} 19{com}.     if "`atmeans'" != "" local atm = 1
{txt} 20{com}. 
.     set seed `seed'
{txt} 21{com}. 
.     di as text _n "{c -(}hline 70{c )-}"
{txt} 22{com}.     di as text "SENSITIVITY PROFILE: `model'"
{txt} 23{com}.     di as text "{c -(}hline 70{c )-}"
{txt} 24{com}.     di as text "Treatment: `D'"
{txt} 25{com}.     di as text "Outcome:   `Y'"
{txt} 26{com}.     if "`X'" != "" di as text "Controls:  `X'"
{txt} 27{com}.     di as text "Fixed rho_Y = " %6.3f `rhoy'
{txt} 28{com}.     di as text "Grid points: `ngrid'"
{txt} 29{com}.     di as text "Confidence level: `level'%"
{txt} 30{com}.     if "`outcome'" != "" di as text "MNL outcome: `outcome'"
{txt} 31{com}. 
.     *===========================================================================
.     * STEP 1: Outcome residuals from short model
.     *===========================================================================
. 
.     if "`model'" == "logit" {c -(}
{txt} 32{com}.         qui logit `Y' `D' `X' if `touse'
{txt} 33{com}.         tempvar mu Yr
{txt} 34{com}.         qui predict double `mu' if `touse', pr
{txt} 35{com}.         qui gen double `Yr' = (`Y' - `mu') / sqrt(`mu'*(1-`mu')) if `touse'
{txt} 36{com}.         qui replace `Yr' = 0 if `Yr' == . & `touse'
{txt} 37{com}.     {c )-}
{txt} 38{com}.     else if "`model'" == "probit" {c -(}
{txt} 39{com}.         qui probit `Y' `D' `X' if `touse'
{txt} 40{com}.         tempvar mu Yr
{txt} 41{com}.         qui predict double `mu' if `touse', pr
{txt} 42{com}.         qui gen double `Yr' = (`Y' - `mu') / sqrt(`mu'*(1-`mu')) if `touse'
{txt} 43{com}.         qui replace `Yr' = 0 if `Yr' == . & `touse'
{txt} 44{com}.     {c )-}
{txt} 45{com}.     else if "`model'" == "cloglog" {c -(}
{txt} 46{com}.         qui cloglog `Y' `D' `X' if `touse'
{txt} 47{com}.         tempvar mu Yr
{txt} 48{com}.         qui predict double `mu' if `touse', pr
{txt} 49{com}.         qui gen double `Yr' = (`Y' - `mu') / sqrt(`mu'*(1-`mu')) if `touse'
{txt} 50{com}.         qui replace `Yr' = 0 if `Yr' == . & `touse'
{txt} 51{com}.     {c )-}
{txt} 52{com}.     else if "`model'" == "poisson" {c -(}
{txt} 53{com}.         qui poisson `Y' `D' `X' if `touse'
{txt} 54{com}.         tempvar mu Yr
{txt} 55{com}.         qui predict double `mu' if `touse', n
{txt} 56{com}.         qui gen double `Yr' = (`Y' - `mu') / sqrt(`mu') if `touse'
{txt} 57{com}.         qui replace `Yr' = 0 if `Yr' == . & `touse'
{txt} 58{com}.     {c )-}
{txt} 59{com}.     else if "`model'" == "nbreg" {c -(}
{txt} 60{com}.         qui nbreg `Y' `D' `X' if `touse'
{txt} 61{com}.         tempvar mu Yr
{txt} 62{com}.         qui predict double `mu' if `touse', n
{txt} 63{com}.         local anb = e(alpha)
{txt} 64{com}.         qui gen double `Yr' = (`Y' - `mu') / sqrt(`mu' + `anb'*`mu'^2) if `touse'
{txt} 65{com}.     {c )-}
{txt} 66{com}.     else if "`model'" == "ologit" {c -(}
{txt} 67{com}.         qui ologit `Y' `D' `X' if `touse'
{txt} 68{com}.         qui levelsof `Y' if `touse', local(ocats)
{txt} 69{com}.         local usecat : word 2 of `ocats'
{txt} 70{com}.         if "`usecat'" == "" local usecat : word 1 of `ocats'
{txt} 71{com}.         tempvar pr Yr
{txt} 72{com}.         qui predict double `pr' if `touse', outcome(`usecat')
{txt} 73{com}.         qui gen double `Yr' = (`Y' == `usecat') - `pr' if `touse'
{txt} 74{com}.     {c )-}
{txt} 75{com}.     else if "`model'" == "mlogit" {c -(}
{txt} 76{com}.         qui mlogit `Y' `D' `X' if `touse', baseoutcome(`baseoutcome')
{txt} 77{com}.         tempvar pr_o Yr
{txt} 78{com}.         qui predict double `pr_o' if `touse', outcome(`outcome')
{txt} 79{com}.         qui gen double `Yr' = (`Y' == real("`outcome'")) - `pr_o' if `touse'
{txt} 80{com}. 
.         * Short-model AME for this outcome
.         if `atm' == 1 qui margins, dydx(`D') atmeans predict(outcome(`outcome'))
{txt} 81{com}.         else          qui margins, dydx(`D') predict(outcome(`outcome'))
{txt} 82{com}.         local me_short = r(table)[1,1]
{txt} 83{com}.         local se_short = r(table)[2,1]
{txt} 84{com}.     {c )-}
{txt} 85{com}. 
.     * Standardise outcome residual
.     qui sum `Yr' if `touse'
{txt} 86{com}.     if r(sd) < 1e-8 {c -(}
{txt} 87{com}.         di as error "Outcome residual SD near zero"
{txt} 88{com}.         exit 498
{txt} 89{com}.     {c )-}
{txt} 90{com}.     qui replace `Yr' = (`Yr' - r(mean)) / r(sd) if `touse'
{txt} 91{com}. 
.     *===========================================================================
.     * STEP 2: Treatment residual (standardised)
.     *===========================================================================
.     tempvar Dr
{txt} 92{com}.     qui reg `D' `X' if `touse'
{txt} 93{com}.     qui predict double `Dr' if `touse', resid
{txt} 94{com}.     qui sum `Dr' if `touse'
{txt} 95{com}.     if r(sd) < 1e-8 {c -(}
{txt} 96{com}.         di as error "Treatment residual SD near zero"
{txt} 97{com}.         exit 498
{txt} 98{com}.     {c )-}
{txt} 99{com}.     qui replace `Dr' = `Dr' / r(sd) if `touse'
{txt}100{com}. 
.     *===========================================================================
.     * STEP 3: Short-model AME and residual correlation
.     *===========================================================================
.     if "`model'" != "mlogit" {c -(}
{txt}101{com}.         if      "`model'" == "logit"   qui logit   `Y' `D' `X' if `touse'
{txt}102{com}.         else if "`model'" == "probit"  qui probit  `Y' `D' `X' if `touse'
{txt}103{com}.         else if "`model'" == "cloglog" qui cloglog `Y' `D' `X' if `touse'
{txt}104{com}.         else if "`model'" == "poisson" qui poisson `Y' `D' `X' if `touse'
{txt}105{com}.         else if "`model'" == "nbreg"   qui nbreg   `Y' `D' `X' if `touse'
{txt}106{com}.         else if "`model'" == "ologit"  qui ologit  `Y' `D' `X' if `touse'
{txt}107{com}. 
.         if `atm' == 1 qui margins, dydx(`D') atmeans
{txt}108{com}.         else          qui margins, dydx(`D')
{txt}109{com}.         local me_short = r(table)[1,1]
{txt}110{com}.         local se_short = r(table)[2,1]
{txt}111{com}.     {c )-}
{txt}112{com}. 
.     qui corr `Dr' `Yr' if `touse'
{txt}113{com}.     local r = r(rho)
{txt}114{com}. 
.     di as text _n "Short model AME: " %9.4f `me_short' ///
>         " (SE: " %7.4f `se_short' ")"
{txt}115{com}.     di as text "r = cor(D_resid, Y_resid) = " %7.4f `r'
{txt}116{com}.     di as text "t_short = " %7.2f (`me_short'/`se_short')
{txt}117{com}. 
.     *===========================================================================
.     * STEP 4: Feasible interval
.     *===========================================================================
.     local disc_feas = (1 - (`r')^2) * (1 - (`rhoy')^2)
{txt}118{com}.     if `disc_feas' < 0 {c -(}
{txt}119{com}.         di as error "No feasible region for rho_Y = `rhoy'"
{txt}120{com}.         exit 498
{txt}121{com}.     {c )-}
{txt}122{com}. 
.     local rd_lo = max(-0.999, `r'*`rhoy' - sqrt(`disc_feas'))
{txt}123{com}.     local rd_hi = min( 0.999, `r'*`rhoy' + sqrt(`disc_feas'))
{txt}124{com}. 
.     * Nudge if boundary is infeasible
.     sens_abc, rd(`rd_hi') ry(`rhoy') rho(`r')
{txt}125{com}.     if $sens_feasible == 0 local rd_hi = `rd_hi' - 0.001
{txt}126{com}.     sens_abc, rd(`rd_lo') ry(`rhoy') rho(`r')
{txt}127{com}.     if $sens_feasible == 0 local rd_lo = `rd_lo' + 0.001
{txt}128{com}. 
.     * Apply scanmargin
.     local feas_width = `rd_hi' - `rd_lo'
{txt}129{com}.     local rd_lo = `rd_lo' + `scanmargin' * `feas_width'
{txt}130{com}.     local rd_hi = `rd_hi' - `scanmargin' * `feas_width'
{txt}131{com}. 
.     di as text "Feasible rho_D range: [" %6.3f `rd_lo' ", " %6.3f `rd_hi' "]"
{txt}132{com}. 
.     *===========================================================================
.     * STEP 5: Fixed epsilon
.     *===========================================================================
.     tempvar eps_fixed
{txt}133{com}.     qui gen double `eps_fixed' = rnormal() if `touse'
{txt}134{com}.     global sens_eps "`eps_fixed'"
{txt}135{com}. 
.     *===========================================================================
.     * STEP 6: Fine-grid evaluation
.     *===========================================================================
.     di as text _n "Evaluating `ngrid' grid points..."
{txt}136{com}. 
.     * Store results in a temporary dataset
.     tempname results
{txt}137{com}.     matrix `results' = J(`ngrid', 5, .)
{txt}138{com}.     * col 1 = rho_D, col 2 = ME, col 3 = SE, col 4 = t-stat, col 5 = success
. 
.     local n_success = 0
{txt}139{com}.     local n_fail    = 0
{txt}140{com}. 
.     forval g = 1/`ngrid' {c -(}
{txt}141{com}.         local rd_g = `rd_lo' + (`g'-1) * (`rd_hi' - `rd_lo') / (`ngrid' - 1)
{txt}142{com}. 
.         matrix `results'[`g', 1] = `rd_g'
{txt}143{com}. 
.         sens_abc, rd(`rd_g') ry(`rhoy') rho(`r')
{txt}144{com}.         if $sens_feasible == 0 {c -(}
{txt}145{com}.             matrix `results'[`g', 5] = 0
{txt}146{com}.             local n_fail = `n_fail' + 1
{txt}147{com}.             continue
{txt}148{com}.         {c )-}
{txt}149{com}. 
.         sens_build_z, dresid(`Dr') yresid(`Yr') touse(`touse')
{txt}150{com}.         sens_fit, model(`model') yvar(`Y') dvar(`D') touse(`touse') ///
>                   atm(`atm') baseoutcome(`baseoutcome') outcome("`outcome'")
{txt}151{com}.         capture drop _Z_hyp_
{txt}152{com}. 
.         if $sens_failed == 0 & $sens_me != . {c -(}
{txt}153{com}.             matrix `results'[`g', 2] = $sens_me
{txt}154{com}.             matrix `results'[`g', 3] = $sens_se
{txt}155{com}.             matrix `results'[`g', 4] = $sens_me / $sens_se
{txt}156{com}.             matrix `results'[`g', 5] = 1
{txt}157{com}.             local n_success = `n_success' + 1
{txt}158{com}.         {c )-}
{txt}159{com}.         else {c -(}
{txt}160{com}.             matrix `results'[`g', 5] = 0
{txt}161{com}.             local n_fail = `n_fail' + 1
{txt}162{com}.         {c )-}
{txt}163{com}. 
.         * Progress indicator every 50 points
.         if mod(`g', 50) == 0 {c -(}
{txt}164{com}.             di as text "  ... `g' / `ngrid' done"
{txt}165{com}.         {c )-}
{txt}166{com}.     {c )-}
{txt}167{com}. 
.     di as text "  Done. Successful: `n_success' / `ngrid'"
{txt}168{com}.     if `n_fail' > 0 {c -(}
{txt}169{com}.         di as text "  Failed evaluations: `n_fail'"
{txt}170{com}.     {c )-}
{txt}171{com}. 
.     *===========================================================================
.     * STEP 7: Build plot dataset and graph
.     *===========================================================================
. 
.     * Preserve current data, build plot dataset
.     preserve
{txt}172{com}.     clear
{txt}173{com}.     qui set obs `ngrid'
{txt}174{com}. 
.     qui gen double rho_D  = .
{txt}175{com}.     qui gen double ME     = .
{txt}176{com}.     qui gen double SE     = .
{txt}177{com}.     qui gen double tstat  = .
{txt}178{com}.     qui gen double abs_t  = .
{txt}179{com}.     qui gen byte   ok     = 0
{txt}180{com}. 
.     forval g = 1/`ngrid' {c -(}
{txt}181{com}.         qui replace rho_D = `results'[`g', 1] in `g'
{txt}182{com}.         if `results'[`g', 5] == 1 {c -(}
{txt}183{com}.             qui replace ME    = `results'[`g', 2] in `g'
{txt}184{com}.             qui replace SE    = `results'[`g', 3] in `g'
{txt}185{com}.             qui replace tstat = `results'[`g', 4] in `g'
{txt}186{com}.             qui replace abs_t = abs(`results'[`g', 4]) in `g'
{txt}187{com}.             qui replace ok    = 1                      in `g'
{txt}188{com}.         {c )-}
{txt}189{com}.     {c )-}
{txt}190{com}. 
.     * Drop failed points for clean plotting
.     qui drop if ok == 0
{txt}191{com}. 
.     * Confidence band for AME
.     qui gen double ME_lo = ME - `z' * SE
{txt}192{com}.     qui gen double ME_hi = ME + `z' * SE
{txt}193{com}. 
.     * Formatting
.     local ry_fmt : di %5.2f `rhoy'
{txt}194{com}.     local me_fmt : di %6.3f `me_short'
{txt}195{com}.     local t_fmt  : di %5.1f (`me_short'/`se_short')
{txt}196{com}.     local out_label ""
{txt}197{com}.     if "`outcome'" != "" local out_label ", outcome `outcome'"
{txt}198{com}. 
.     * ---- Panel 1: AME ----
.     twoway ///
>         (rarea ME_lo ME_hi rho_D, color(gs14) lwidth(none)) ///
>         (line ME rho_D, lcolor(navy) lwidth(medthick)) ///
>         (function y = 0, range(rho_D) lcolor(cranberry) lpattern(dash) lwidth(medium)) ///
>         (function y = `me_short', range(rho_D) lcolor(gs8) lpattern(shortdash) lwidth(thin)) ///
>         , ///
>         title("Adjusted AME as a function of {c -(}&rho{c )-}{c -(}sub:D{c )-}" ///
>               "({c -(}&rho{c )-}{c -(}sub:Y{c )-} = `ry_fmt'`out_label')", size(medium)) ///
>         xtitle("{c -(}&rho{c )-}{c -(}sub:D{c )-}") ///
>         ytitle("Adjusted AME") ///
>         ylabel(, angle(horizontal) format(%7.3f)) ///
>         xlabel(, format(%5.2f)) ///
>         legend(order(2 "Adjusted AME" 1 "`level'% CI" ///
>        3 "AME = 0" 4 "Short-model AME") ///
>        rows(1) size(small) position(6) lstyle(none) region(lcolor(white))) ///
>         scheme(s2color) ///
>                 graphregion(color(white)) plotregion(color(white)) ///
>         name(sens_profile_ame, replace)
{txt}199{com}. 
.     * ---- Panel 2: |t|-statistic ----
.     twoway ///
>         (line abs_t rho_D, lcolor(navy) lwidth(medthick)) ///
>         (function y = `z', range(rho_D) lcolor(cranberry) lpattern(dash) lwidth(medium)) ///
>         , ///
>         title("|t|-statistic as a function of {c -(}&rho{c )-}{c -(}sub:D{c )-}" ///
>               "({c -(}&rho{c )-}{c -(}sub:Y{c )-} = `ry_fmt'`out_label')", size(medium)) ///
>         xtitle("{c -(}&rho{c )-}{c -(}sub:D{c )-}") ///
>         ytitle("|t|") ///
>         ylabel(, angle(horizontal) format(%5.1f)) ///
>         xlabel(, format(%5.2f)) ///
>         yline(`z', lcolor(cranberry) lpattern(dash) lwidth(medium)) ///
>         legend(order(1 "|t|-statistic" 2 "z = `z'") ///
>                rows(1) size(small) position(6) lstyle(none) region(lcolor(white)) ) ///
>          graphregion(color(white)) plotregion(color(white)) ///
>         scheme(s2mono) ///
>         name(sens_profile_tstat, replace)
{txt}200{com}. 
.     * ---- Combined ----
.     graph combine sens_profile_ame sens_profile_tstat, ///
>         cols(1) iscale(0.8) ///
>         title("Sensitivity Profile: `model'", size(medium)) ///
>         subtitle("Short-model AME = `me_fmt' (t = `t_fmt')" ///
>                  "Fixed {c -(}&rho{c )-}{c -(}sub:Y{c )-} = `ry_fmt', grid = `ngrid' points", ///
>                  size(small)) ///
>         name(sens_profile_combined, replace)
{txt}201{com}. 
.     * ---- Save if requested ----
.     if "`saving'" != "" {c -(}
{txt}202{com}.         graph export "`saving'_combined.png", name(sens_profile_combined) ///
>             width(2400) `replace'
{txt}203{com}.         graph export "`saving'_ame.png", name(sens_profile_ame) ///
>             width(2400) `replace'
{txt}204{com}.         graph export "`saving'_tstat.png", name(sens_profile_tstat) ///
>             width(2400) `replace'
{txt}205{com}.         di as text _n "Graphs saved to `saving'_combined.png, " ///
>             "`saving'_ame.png, `saving'_tstat.png"
{txt}206{com}.     {c )-}
{txt}207{com}. 
.     * ---- Save dataset if requested ----
.     if "`saving'" != "" {c -(}
{txt}208{com}.         qui save "`saving'_data.dta", `replace'
{txt}209{com}.         di as text "Data saved to `saving'_data.dta"
{txt}210{com}.     {c )-}
{txt}211{com}. 
.     *===========================================================================
.     * STEP 8: Locate and report crossings
.     *===========================================================================
.     di as text _n "{c -(}hline 70{c )-}"
{txt}212{com}.     di as text "THRESHOLD CROSSINGS DETECTED"
{txt}213{com}.     di as text "{c -(}hline 70{c )-}"
{txt}214{com}. 
.     local sign0 = sign(`me_short')
{txt}215{com}. 
.     * Explain-away crossings: where |t| crosses z
.     local n_ea = 0
{txt}216{com}.     local prev_above = .
{txt}217{com}.     local prev_rd    = .
{txt}218{com}.     local N = _N
{txt}219{com}.     forval i = 1/`N' {c -(}
{txt}220{com}.         local this_t    = abs_t[`i']
{txt}221{com}.         local this_rd   = rho_D[`i']
{txt}222{com}.         local this_above = (`this_t' >= `z')
{txt}223{com}. 
.         if `prev_above' != . & `this_above' != `prev_above' {c -(}
{txt}224{com}.             local n_ea = `n_ea' + 1
{txt}225{com}.             local cross_rd = (`prev_rd' + `this_rd') / 2
{txt}226{com}.             di as text "  Explain-away crossing #`n_ea' at rho_D ~ " ///
>                 %7.4f `cross_rd'
{txt}227{com}.         {c )-}
{txt}228{com}.         local prev_above = `this_above'
{txt}229{com}.         local prev_rd    = `this_rd'
{txt}230{com}.     {c )-}
{txt}231{com}.     if `n_ea' == 0 {c -(}
{txt}232{com}.         di as text "  No explain-away crossings (effect remains significant" ///
>             " throughout)"
{txt}233{com}.     {c )-}
{txt}234{com}. 
.     * Sign-change crossings: where ME crosses zero
.     local n_sc = 0
{txt}235{com}.     local prev_sign = .
{txt}236{com}.     local prev_rd   = .
{txt}237{com}.     forval i = 1/`N' {c -(}
{txt}238{com}.         local this_me   = ME[`i']
{txt}239{com}.         local this_rd   = rho_D[`i']
{txt}240{com}.         local this_sign = sign(`this_me')
{txt}241{com}. 
.         if `prev_sign' != . & `this_sign' != `prev_sign' & `this_sign' != 0 {c -(}
{txt}242{com}.             local n_sc = `n_sc' + 1
{txt}243{com}.             local cross_rd = (`prev_rd' + `this_rd') / 2
{txt}244{com}.             di as text "  Sign-change crossing #`n_sc' at rho_D ~ " ///
>                 %7.4f `cross_rd'
{txt}245{com}.         {c )-}
{txt}246{com}.         local prev_sign = `this_sign'
{txt}247{com}.         local prev_rd   = `this_rd'
{txt}248{com}.     {c )-}
{txt}249{com}.     if `n_sc' == 0 {c -(}
{txt}250{com}.         di as text "  No sign-change crossings (sign never reverses)"
{txt}251{com}.     {c )-}
{txt}252{com}.     di as text "{c -(}hline 70{c )-}"
{txt}253{com}. 
.     restore
{txt}254{com}. 
.     * Return values
.     return scalar me_short = `me_short'
{txt}255{com}.     return scalar se_short = `se_short'
{txt}256{com}.     return scalar r        = `r'
{txt}257{com}.     return scalar rho_y    = `rhoy'
{txt}258{com}.     return scalar rd_lo    = `rd_lo'
{txt}259{com}.     return scalar rd_hi    = `rd_hi'
{txt}260{com}.     return scalar n_ea     = `n_ea'
{txt}261{com}.     return scalar n_sc     = `n_sc'
{txt}262{com}.     return matrix profile  = `results'
{txt}263{com}. 
.     * Clean up
.     macro drop sens_X sens_eps sens_a sens_b sens_c sens_feasible ///
>                sens_me sens_se sens_failed sens_delta
{txt}264{com}. 
. end
{txt}
{com}. 
{txt}end of do-file

