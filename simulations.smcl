{com}. 
. 
. *===============================================================================
. * simulation_comparison_v3
. *
. * PURPOSE: Compare three sensitivity analysis methods across a grid of
. *   confounding strengths. Tests the theoretical prediction that the
. *   CH linear approximation error grows with delta_Z (O(delta^2) remainder)
. *   while the synthetic method remains accurate throughout.
. *
. * NOTE ON SCOPE: this simulation does NOT call the sensitivity package
. * (sensitivity / sens_bisect / sens_fit / sens_abc / sens_build_z) at
. * all. Its "Synthetic" method reimplements the a/b/c synthetic-confounder
. * construction inline, independently of sens_abc. It is therefore
. * UNAFFECTED by the validate-then-bisect redesign of sens_bisect, and is
. * included here unchanged purely so this single file reproduces every
. * simulation from the original script. If you only care about results
. * that depend on sens_bisect's behavior, this section can be skipped.
. *
. * DESIGN:
. *   6 cells: 2 treatment effect levels x 3 confounding strengths.
. *   Everything else fixed: intc=-0.5, scale=1, nobs=1000.
. *
. *   Cell 1: beta_D=0,   delta_Z=0.2, rho_D=0.3  [null, very weak]
. *   Cell 2: beta_D=0,   delta_Z=0.5, rho_D=0.4  [null, moderate]
. *   Cell 3: beta_D=0,   delta_Z=0.8, rho_D=0.6  [null, strong]
. *   Cell 4: beta_D=0.5, delta_Z=0.2, rho_D=0.3  [positive, very weak]
. *   Cell 5: beta_D=0.5, delta_Z=0.5, rho_D=0.4  [positive, moderate]
. *   Cell 6: beta_D=0.5, delta_Z=0.8, rho_D=0.6  [positive, strong]
. *
. * KEY PREDICTION:
. *   MAE advantage of synthetic over CH should grow monotonically with
. *   delta_Z, consistent with the O(delta^2) remainder in the OVB lemma.
. *   CH bias should be approximately zero at delta_Z=0.2 and grow
. *   quadratically as delta_Z increases to 0.5 and 0.8.
. *
. * PRIMARY METRIC:  MAE = mean|adjusted AME - true AME|
. * SECONDARY:       Bias = mean(adjusted AME - true AME)
. *                  Direction error rate
. *
. * METHODS:
. *   CH-OLS:    short OLS + OLS residuals + CH formula
. *   CH-adapted: short logit AME + logit Pearson residuals + CH formula
. *   Synthetic: short logit + logit Pearson residuals + exact re-estimation
. *
. * GROUND TRUTH: true population AME from logit on N=200,000 draws.
. * NO conditioning on short-model significance.
. *
. * SEEDING CAVEAT (unchanged from the original — flagged, not fixed here):
. *   A single `set seed 12345` is called once, immediately before
. *   `sim_v3, nsim(10000) nobs(5000)` at the bottom of this section. Every
. *   random draw inside sim_v3 (the population true-AME draw for each
. *   cell, then that cell's nsim replications) consumes one continuous
. *   stream in a fixed order. The full run is exactly reproducible, but
. *   re-running a single cell in isolation, or changing nsim/nobs, will
. *   NOT reproduce any individual cell's original numbers, because the
. *   RNG state at the start of a later cell depends on exactly how many
. *   draws every earlier cell consumed. If per-cell reproducibility is
. *   wanted, each cell would need its own seed (e.g. derived from a base
. *   seed plus the cell index) — not changed here to keep this section a
. *   faithful, unmodified port of the original.
. *===============================================================================
. 
. capture program drop ch_ols_adjusted
{txt}
{com}. program define ch_ols_adjusted
{txt}  1{com}.     syntax , b(real) se(real) n(real) r2dz(real) r2yz(real) ///
>              [ ncontrols(integer 2) ]
{txt}  2{com}. 
.     global ch_t_adj = .
{txt}  3{com}.     global ch_b_adj = .
{txt}  4{com}. 
.     if `r2dz' >= 1 | `r2yz' >= 1 | `r2dz' < 0 | `r2yz' < 0 exit
{txt}  5{com}.     if `se' <= 0 exit
{txt}  6{com}. 
.     local dof    = `n' - `ncontrols' - 2
{txt}  7{com}.     if `dof' <= 0 exit
{txt}  8{com}. 
.     local t_short   = `b' / `se'
{txt}  9{com}.     local sign_t    = sign(`t_short')
{txt} 10{com}.     local denom_r2  = max(1e-10, 1 - `r2dz')
{txt} 11{com}.     local bf        = sqrt(`r2yz' * `r2dz' / `denom_r2')
{txt} 12{com}.     local bias_on_t = `sign_t' * `bf' * sqrt(`dof')
{txt} 13{com}. 
.     global ch_t_adj = `t_short' - `bias_on_t'
{txt} 14{com}.     global ch_b_adj = `b' - `sign_t' * `bf' * `se' * sqrt(`dof')
{txt} 15{com}. 
. end
{txt}
{com}. 
. 
. capture program drop compute_true_ame
{txt}
{com}. program define compute_true_ame
{txt}  1{com}.     syntax , intc(real) beta(real) g1(real) g2(real) ///
>              delta(real) rho0(real)
{txt}  2{com}. 
.     preserve
{txt}  3{com}.     quietly {c -(}
{txt}  4{com}.         clear
{txt}  5{com}.         set obs 500000
{txt}  6{com}.         gen X1 = rnormal()
{txt}  7{com}.         gen X2 = rnormal()
{txt}  8{com}.         gen D  = (0.3*X1 + rnormal() > 0)
{txt}  9{com}. 
.         reg D X1 X2
{txt} 10{com}.         predict double Dr0, resid
{txt} 11{com}.         sum Dr0
{txt} 12{com}.         replace Dr0 = Dr0 / r(sd)
{txt} 13{com}.         gen double Z = `rho0'*Dr0 + sqrt(1-`rho0'^2)*rnormal()
{txt} 14{com}.         drop Dr0
{txt} 15{com}. 
.         gen double eta = `intc' + `beta'*D + `g1'*X1 + `g2'*X2 + `delta'*Z
{txt} 16{com}.         gen byte   Y   = runiform() < invlogit(eta)
{txt} 17{com}. 
.         logit Y D X1 X2 Z
{txt} 18{com}.         margins, dydx(D)
{txt} 19{com}.         global true_ame_mc = r(table)[1,1]
{txt} 20{com}.                 
.                 *-----------------------------------------------------------------------
.         * True rho_Y: partial correlation between Z and the outcome residual
.         * from the SHORT model (omitting Z), after partialling Z on X1 X2.
.         *
.         * Step 1: fit the short logit (omitting Z) and compute Pearson residuals
.         * Step 2: residualise Z on X1 X2 to get Zr
.         * Step 3: standardise both and compute their correlation
.         *
.         * This is the population analogue of what the sensitivity command
.         * computes in finite samples, so it gives the true rho_Y that the
.         * benchmark analysis would recover if Z were observed.
.         *-----------------------------------------------------------------------
. 
.         * Short model Pearson residuals
.         logit Y D X1 X2
{txt} 21{com}.         predict double mu_short, pr
{txt} 22{com}.         gen double Yr_short = (Y - mu_short) / sqrt(mu_short*(1-mu_short))
{txt} 23{com}.         replace Yr_short = 0 if Yr_short == .
{txt} 24{com}.         sum Yr_short
{txt} 25{com}.         replace Yr_short = (Yr_short - r(mean)) / r(sd)
{txt} 26{com}. 
.         * Treatment residual (standardised) — same as sensitivity command
.         reg D X1 X2
{txt} 27{com}.         predict double Dr_short, resid
{txt} 28{com}.         sum Dr_short
{txt} 29{com}.         replace Dr_short = Dr_short / r(sd)
{txt} 30{com}. 
.         * Residualise Z on X1 X2 (partialling out controls)
.         reg Z X1 X2
{txt} 31{com}.         predict double Zr, resid
{txt} 32{com}.         sum Zr
{txt} 33{com}.         replace Zr = Zr / r(sd)
{txt} 34{com}. 
.         * rho_D: partial correlation of Z with treatment residual
.         corr Zr Dr_short
{txt} 35{com}.         global true_rhoD_mc = r(rho)
{txt} 36{com}. 
.         * rho_Y: partial correlation of Z with outcome residual
.         corr Zr Yr_short
{txt} 37{com}.         global true_rhoY_mc = r(rho)
{txt} 38{com}. 
.         drop mu_short Yr_short Dr_short Zr
{txt} 39{com}.     {c )-}
{txt} 40{com}.     restore
{txt} 41{com}. end
{txt}
{com}. 
. 
. capture program drop sim_v3
{txt}
{com}. program define sim_v3, rclass
{txt}  1{com}. 
.     syntax , nsim(integer) nobs(integer)
{txt}  2{com}. 
.     *---------------------------------------------------------------------------
.     * Fixed DGP parameters
.     *---------------------------------------------------------------------------
.     local g1   =  0.3
{txt}  3{com}.     local g2   =  0.2
{txt}  4{com}.     local intc = -0.5
{txt}  5{com}. 
.     *---------------------------------------------------------------------------
.     * Cell definitions
.     *---------------------------------------------------------------------------
.     local cell_beta  "0    0    0    0.5  0.5  0.5"
{txt}  6{com}.     local cell_delta "0.2  0.5  0.8  0.2  0.5  0.8"
{txt}  7{com}.     local cell_rho   "0.3  0.4  0.6  0.3  0.4  0.6"
{txt}  8{com}.     local cell_label `""null/very-weak" "null/moderate" "null/strong" "pos/very-weak" "pos/moderate" "pos/strong""'
{txt}  9{com}.     local ncells = 6
{txt} 10{com}. 
.     *---------------------------------------------------------------------------
.     * Results matrices: 6 cells x 3 methods
.     *---------------------------------------------------------------------------
.     tempname res_mae res_bias res_dir res_trueame
{txt} 11{com}.     matrix `res_mae'    = J(`ncells', 3, .)
{txt} 12{com}.     matrix `res_bias'   = J(`ncells', 3, .)
{txt} 13{com}.     matrix `res_dir'    = J(`ncells', 3, .)
{txt} 14{com}.     matrix `res_trueame'= J(`ncells', 1, .)
{txt} 15{com}.     matrix colnames `res_mae'  = CH_OLS CH_adapted Synthetic
{txt} 16{com}.     matrix colnames `res_bias' = CH_OLS CH_adapted Synthetic
{txt} 17{com}.     matrix colnames `res_dir'  = CH_OLS CH_adapted Synthetic
{txt} 18{com}.     matrix rownames `res_mae'  = c1 c2 c3 c4 c5 c6
{txt} 19{com}.     matrix rownames `res_bias' = c1 c2 c3 c4 c5 c6
{txt} 20{com}.     matrix rownames `res_dir'  = c1 c2 c3 c4 c5 c6
{txt} 21{com}. 
.     *---------------------------------------------------------------------------
.     * Cell loop
.     *---------------------------------------------------------------------------
.     forval cell = 1/`ncells' {c -(}
{txt} 22{com}. 
.         local beta_d = real(word("`cell_beta'",  `cell'))
{txt} 23{com}.         local dlt    = real(word("`cell_delta'", `cell'))
{txt} 24{com}.         local rho0   = real(word("`cell_rho'",   `cell'))
{txt} 25{com}.         local lbl    : word `cell' of `cell_label'
{txt} 26{com}.         local null_cell = (`beta_d' == 0)
{txt} 27{com}. 
.         di as text _n "{c -(}hline 70{c )-}"
{txt} 28{com}.         di as text "CELL `cell': `lbl'"
{txt} 29{com}.         di as text "  beta_D=`beta_d'  delta_Z=`dlt'  rho_D=`rho0'"
{txt} 30{com}.         di as text "{c -(}hline 70{c )-}"
{txt} 31{com}. 
.         *-----------------------------------------------------------------------
.         * True AME
.         *-----------------------------------------------------------------------
.         compute_true_ame, intc(`intc') beta(`beta_d') g1(`g1') g2(`g2') ///
>             delta(`dlt') rho0(`rho0')
{txt} 32{com}.         local true_ame = $true_ame_mc
{txt} 33{com}.         matrix `res_trueame'[`cell',1] = `true_ame'
{txt} 34{com}.         di as text "  True AME = " %8.4f `true_ame'
{txt} 35{com}. 
.         *-----------------------------------------------------------------------
.         * Accumulators
.         *-----------------------------------------------------------------------
.         foreach m in ols cha syn {c -(}
{txt} 36{com}.             local `m'_sum_ae = 0
{txt} 37{com}.             local `m'_sum_se = 0
{txt} 38{com}.             local `m'_n_dir  = 0
{txt} 39{com}.             local `m'_valid  = 0
{txt} 40{com}.         {c )-}
{txt} 41{com}. 
.         *-----------------------------------------------------------------------
.         * Simulation loop
.         *-----------------------------------------------------------------------
.         forval sim = 1/`nsim' {c -(}
{txt} 42{com}.         quietly {c -(}
{txt} 43{com}. 
.             *-------------------------------------------------------------------
.             * 1. Generate data
.             *-------------------------------------------------------------------
.             clear
{txt} 44{com}.             set obs `nobs'
{txt} 45{com}.             gen X1 = rnormal()
{txt} 46{com}.             gen X2 = rnormal()
{txt} 47{com}.             gen D  = (0.3*X1 + rnormal() > 0)
{txt} 48{com}. 
.             reg D X1 X2
{txt} 49{com}.             predict double Dr0, resid
{txt} 50{com}.             sum Dr0
{txt} 51{com}.             replace Dr0 = Dr0 / r(sd)
{txt} 52{com}.             gen double Z = `rho0'*Dr0 + sqrt(1-`rho0'^2)*rnormal()
{txt} 53{com}.             drop Dr0
{txt} 54{com}. 
.             gen double eta = `intc' + `beta_d'*D + `g1'*X1 + `g2'*X2 + `dlt'*Z
{txt} 55{com}.             gen byte   Y   = runiform() < invlogit(eta)
{txt} 56{com}. 
.             *-------------------------------------------------------------------
.             * 2. Short logit
.             *-------------------------------------------------------------------
.             local skip = 0
{txt} 57{com}.             capture {c -(}
{txt} 58{com}.                 logit Y D X1 X2
{txt} 59{com}.                 margins, dydx(D)
{txt} 60{com}.                 local me_short = r(table)[1,1]
{txt} 61{com}.                 local se_short = r(table)[2,1]
{txt} 62{com}. 
.                 predict double mu_s, pr
{txt} 63{com}.                 gen double Yr = (Y - mu_s) / sqrt(mu_s*(1-mu_s))
{txt} 64{com}.                 replace Yr = 0 if Yr == .
{txt} 65{com}.                 sum Yr
{txt} 66{com}.                 replace Yr = (Yr - r(mean)) / r(sd)
{txt} 67{com}.                 drop mu_s
{txt} 68{com}.             {c )-}
{txt} 69{com}.             if _rc != 0 local skip = 1
{txt} 70{com}.             if `skip' {c -(}
{txt} 71{com}.                 drop _all
{txt} 72{com}.                 set obs 1
{txt} 73{com}.                 continue
{txt} 74{com}.             {c )-}
{txt} 75{com}. 
.             * Treatment residual
.             reg D X1 X2
{txt} 76{com}.             predict double Dr, resid
{txt} 77{com}.             sum Dr
{txt} 78{com}.             replace Dr = Dr / r(sd)
{txt} 79{com}. 
.             corr Dr Yr
{txt} 80{com}.             local r_main = r(rho)
{txt} 81{com}. 
.             *-------------------------------------------------------------------
.             * 3. Benchmark partial correlations for Z
.             *-------------------------------------------------------------------
.             reg Z X1 X2
{txt} 82{com}.             predict double Zr, resid
{txt} 83{com}.             sum Zr
{txt} 84{com}.             replace Zr = Zr / r(sd)
{txt} 85{com}. 
.             corr Zr Dr
{txt} 86{com}.             local rho_D_k = r(rho)
{txt} 87{com}.             corr Zr Yr
{txt} 88{com}.             local rho_Y_k = r(rho)
{txt} 89{com}. 
.             *-------------------------------------------------------------------
.             * METHOD 1: CH-OLS
.             *-------------------------------------------------------------------
.             local ols_adj = .
{txt} 90{com}.             capture {c -(}
{txt} 91{com}.                 reg Y D X1 X2
{txt} 92{com}.                 local b_ols  = _b[D]
{txt} 93{com}.                 local se_ols = _se[D]
{txt} 94{com}.                 local n_ols  = e(N)
{txt} 95{com}. 
.                 predict double Yr_ols, resid
{txt} 96{com}.                 sum Yr_ols
{txt} 97{com}.                 replace Yr_ols = (Yr_ols - r(mean)) / r(sd)
{txt} 98{com}. 
.                 reg D X1 X2
{txt} 99{com}.                 predict double Dr_ols, resid
{txt}100{com}.                 sum Dr_ols
{txt}101{com}.                 replace Dr_ols = Dr_ols / r(sd)
{txt}102{com}. 
.                 corr Zr Dr_ols
{txt}103{com}.                 local r2dz_ols = r(rho)^2
{txt}104{com}.                 corr Zr Yr_ols
{txt}105{com}.                 local r2yz_ols = r(rho)^2
{txt}106{com}.                 drop Yr_ols Dr_ols
{txt}107{com}. 
.                 ch_ols_adjusted, b(`b_ols') se(`se_ols') n(`n_ols') ///
>                     r2dz(`r2dz_ols') r2yz(`r2yz_ols') ncontrols(2)
{txt}108{com}.                 local ols_adj = $ch_b_adj
{txt}109{com}.             {c )-}
{txt}110{com}.             if _rc != 0 local ols_adj = .
{txt}111{com}. 
.             *-------------------------------------------------------------------
.             * METHOD 2: CH-adapted
.             *-------------------------------------------------------------------
.             local cha_adj = .
{txt}112{com}.             capture {c -(}
{txt}113{com}.                 local r2dz_cha = `rho_D_k'^2
{txt}114{com}.                 local r2yz_cha = `rho_Y_k'^2
{txt}115{com}.                 ch_ols_adjusted, b(`me_short') se(`se_short') n(`nobs') ///
>                     r2dz(`r2dz_cha') r2yz(`r2yz_cha') ncontrols(2)
{txt}116{com}.                 local cha_adj = $ch_b_adj
{txt}117{com}.             {c )-}
{txt}118{com}.             if _rc != 0 local cha_adj = .
{txt}119{com}. 
.             *-------------------------------------------------------------------
.             * METHOD 3: Synthetic confounder
.             *-------------------------------------------------------------------
.             local syn_adj = .
{txt}120{com}.             local denom_syn = 1 - `r_main'^2
{txt}121{com}.             if abs(`denom_syn') >= 1e-8 {c -(}
{txt}122{com}.                 local av  = (`rho_D_k' - `rho_Y_k'*`r_main') / `denom_syn'
{txt}123{com}.                 local bv  = (`rho_Y_k' - `rho_D_k'*`r_main') / `denom_syn'
{txt}124{com}.                 local csq = 1 - `av'^2 - `bv'^2 - 2*`av'*`bv'*`r_main'
{txt}125{com}.                 if `csq' >= -1e-10 {c -(}
{txt}126{com}.                     local cv = sqrt(max(0, `csq'))
{txt}127{com}.                     gen double eps_v = rnormal()
{txt}128{com}.                     gen double Z_hyp = `av'*Dr + `bv'*Yr + `cv'*eps_v
{txt}129{com}.                     capture {c -(}
{txt}130{com}.                         logit Y D X1 X2 Z_hyp
{txt}131{com}.                         margins, dydx(D)
{txt}132{com}.                         local syn_adj = r(table)[1,1]
{txt}133{com}.                     {c )-}
{txt}134{com}.                     if _rc != 0 local syn_adj = .
{txt}135{com}.                     drop Z_hyp eps_v
{txt}136{com}.                 {c )-}
{txt}137{com}.             {c )-}
{txt}138{com}. 
.  *-------------------------------------------------------------------
.             * 4. Accumulate errors
.             * Direction error: adjustment moved AME in wrong direction
.             * i.e. (adj - short) has opposite sign to (true - short)
.             * Correct direction: adjustment should move AME toward true_ame
.             *-------------------------------------------------------------------
.             foreach m in ols cha syn {c -(}
{txt}139{com}.                 local adj = ``m'_adj'
{txt}140{com}.                 if `adj' != . {c -(}
{txt}141{com}.                     local `m'_valid  = ``m'_valid'  + 1
{txt}142{com}.                     local `m'_sum_ae = ``m'_sum_ae' + abs(`adj' - `true_ame')
{txt}143{com}.                     local `m'_sum_se = ``m'_sum_se' + (`adj' - `true_ame')
{txt}144{com}. 
.                     * Direction of required adjustment
.                     local required_dir = sign(`true_ame' - `me_short')
{txt}145{com}.                     * Direction of actual adjustment
.                     local actual_dir   = sign(`adj' - `me_short')
{txt}146{com}. 
.                     * Error if actual direction opposes required direction
.                     * (ignore draws where required adjustment is exactly zero)
.                     if `required_dir' != 0 {c -(}
{txt}147{com}.                         if `actual_dir' != `required_dir' {c -(}
{txt}148{com}.                             local `m'_n_dir = ``m'_n_dir' + 1
{txt}149{com}.                         {c )-}
{txt}150{com}.                     {c )-}
{txt}151{com}.                 {c )-}
{txt}152{com}.             {c )-}
{txt}153{com}. 
.             drop Dr Yr Zr
{txt}154{com}. 
.         {c )-} // end quietly
{txt}155{com}.         {c )-} // end sim loop
{txt}156{com}. 
.         *-----------------------------------------------------------------------
.         * Store results
.         *-----------------------------------------------------------------------
.         local col = 1
{txt}157{com}.         foreach m in ols cha syn {c -(}
{txt}158{com}.             local dv = max(1, ``m'_valid')
{txt}159{com}.             local mae_`m'  = ``m'_sum_ae' / `dv'
{txt}160{com}.             local bias_`m' = ``m'_sum_se' / `dv'
{txt}161{com}.             local dir_`m'  = 100 * ``m'_n_dir' / `dv'
{txt}162{com}.             matrix `res_mae'[`cell',`col']  = `mae_`m''
{txt}163{com}.             matrix `res_bias'[`cell',`col'] = `bias_`m''
{txt}164{com}.             matrix `res_dir'[`cell',`col']  = `dir_`m''
{txt}165{com}.             local col = `col' + 1
{txt}166{com}.         {c )-}
{txt}167{com}. 
.         di as text "  Valid draws: ols=`ols_valid'  cha=`cha_valid'" ///
>                    "  syn=`syn_valid'"
{txt}168{com}.         di as text %32s " " %14s "CH-OLS" %14s "CH-adapted" %14s "Synthetic"
{txt}169{com}.         di as text %32s "MAE" ///
>             %14.4f `mae_ols'  %14.4f `mae_cha'  %14.4f `mae_syn'
{txt}170{com}.         di as text %32s "Bias" ///
>             %14.4f `bias_ols' %14.4f `bias_cha' %14.4f `bias_syn'
{txt}171{com}.         if `null_cell' {c -(}
{txt}172{com}.             di as text %32s "Made-worse rate (%)" ///
>                 %14.1f `dir_ols' %14.1f `dir_cha' %14.1f `dir_syn'
{txt}173{com}.         {c )-}
{txt}174{com}.         else {c -(}
{txt}175{com}.             di as text %32s "Direction error rate (%)" ///
>                 %14.1f `dir_ols' %14.1f `dir_cha' %14.1f `dir_syn'
{txt}176{com}.         {c )-}
{txt}177{com}. 
.     {c )-} // end cell loop
{txt}178{com}. 
.     *---------------------------------------------------------------------------
.     * Summary tables
.     *---------------------------------------------------------------------------
. 
.     * --- Table 1: MAE ---
.     di as text _n "{c -(}hline 80{c )-}"
{txt}179{com}.     di as text "TABLE 1: MEAN ABSOLUTE ERROR — lower is better"
{txt}180{com}.     di as text "Prediction: MAE advantage of synthetic grows with delta_Z."
{txt}181{com}.     di as text "{c -(}hline 80{c )-}"
{txt}182{com}.     di as text %22s "Cell" %10s "delta_Z" %14s "CH-OLS" ///
>                %14s "CH-adapted" %14s "Synthetic"
{txt}183{com}.     di as text "{c -(}hline 80{c )-}"
{txt}184{com}.     forval c = 1/`ncells' {c -(}
{txt}185{com}.         local lbl   : word `c' of `cell_label'
{txt}186{com}.         local dlt_c = real(word("`cell_delta'", `c'))
{txt}187{com}.         di as result %22s "`lbl'" %10.1f `dlt_c' ///
>             %14.4f `res_mae'[`c',1] ///
>             %14.4f `res_mae'[`c',2] ///
>             %14.4f `res_mae'[`c',3]
{txt}188{com}.         * Separator between null and positive panels
.         if `c' == 3 di as text %80s "{c -(}hline 80{c )-}"
{txt}189{com}.     {c )-}
{txt}190{com}.     di as text "{c -(}hline 80{c )-}"
{txt}191{com}. 
.     * --- Table 2: Bias ---
.     di as text _n "{c -(}hline 80{c )-}"
{txt}192{com}.     di as text "TABLE 2: BIAS (adjusted AME - true AME)"
{txt}193{com}.     di as text "Positive=overcorrects, negative=undercorrects."
{txt}194{com}.     di as text "Prediction: CH bias grows with delta_Z (O(delta^2))."
{txt}195{com}.     di as text "{c -(}hline 80{c )-}"
{txt}196{com}.     di as text %22s "Cell" %10s "delta_Z" %14s "CH-OLS" ///
>                %14s "CH-adapted" %14s "Synthetic"
{txt}197{com}.     di as text "{c -(}hline 80{c )-}"
{txt}198{com}.     forval c = 1/`ncells' {c -(}
{txt}199{com}.         local lbl   : word `c' of `cell_label'
{txt}200{com}.         local dlt_c = real(word("`cell_delta'", `c'))
{txt}201{com}.         di as result %22s "`lbl'" %10.1f `dlt_c' ///
>             %14.4f `res_bias'[`c',1] ///
>             %14.4f `res_bias'[`c',2] ///
>             %14.4f `res_bias'[`c',3]
{txt}202{com}.         if `c' == 3 di as text %80s "{c -(}hline 80{c )-}"
{txt}203{com}.     {c )-}
{txt}204{com}.     di as text "{c -(}hline 80{c )-}"
{txt}205{com}. 
.     * --- Table 3: Direction error ---
.     di as text _n "{c -(}hline 80{c )-}"
{txt}206{com}.     di as text "TABLE 3: DIRECTION ERROR RATE (%)"
{txt}207{com}. di as text "% draws where adjustment moved AME away from true AME."
{txt}208{com}. di as text "Applies to all cells consistently."
{txt}209{com}. di as text "Should be near 0% for all methods when confounding is strong."
{txt}210{com}. di as text "May be noisy when required adjustment is near zero (weak conf.)."
{txt}211{com}.     di as text "{c -(}hline 80{c )-}"
{txt}212{com}.     di as text %22s "Cell" %10s "delta_Z" %14s "CH-OLS" ///
>                %14s "CH-adapted" %14s "Synthetic"
{txt}213{com}.     di as text "{c -(}hline 80{c )-}"
{txt}214{com}.     forval c = 1/`ncells' {c -(}
{txt}215{com}.         local lbl   : word `c' of `cell_label'
{txt}216{com}.         local dlt_c = real(word("`cell_delta'", `c'))
{txt}217{com}.         di as result %22s "`lbl'" %10.1f `dlt_c' ///
>             %14.1f `res_dir'[`c',1] ///
>             %14.1f `res_dir'[`c',2] ///
>             %14.1f `res_dir'[`c',3]
{txt}218{com}.         if `c' == 3 di as text %80s "{c -(}hline 80{c )-}"
{txt}219{com}.     {c )-}
{txt}220{com}.     di as text "{c -(}hline 80{c )-}"
{txt}221{com}. 
.     * --- Ratio table: synthetic MAE advantage ---
.     di as text _n "{c -(}hline 80{c )-}"
{txt}222{com}.     di as text "TABLE 4: RATIO CH-OLS MAE / SYNTHETIC MAE"
{txt}223{com}.     di as text "Values > 1 favour synthetic. Prediction: ratio grows with delta_Z."
{txt}224{com}.     di as text "{c -(}hline 80{c )-}"
{txt}225{com}.     di as text %22s "Cell" %10s "delta_Z" ///
>                %24s "CH-OLS / Synthetic" %24s "CH-adapted / Synthetic"
{txt}226{com}.     di as text "{c -(}hline 80{c )-}"
{txt}227{com}.     forval c = 1/`ncells' {c -(}
{txt}228{com}.         local lbl   : word `c' of `cell_label'
{txt}229{com}.         local dlt_c = real(word("`cell_delta'", `c'))
{txt}230{com}.         local ratio_ols = `res_mae'[`c',1] / max(1e-8, `res_mae'[`c',3])
{txt}231{com}.         local ratio_cha = `res_mae'[`c',2] / max(1e-8, `res_mae'[`c',3])
{txt}232{com}.         di as result %22s "`lbl'" %10.1f `dlt_c' ///
>             %24.2f `ratio_ols' %24.2f `ratio_cha'
{txt}233{com}.         if `c' == 3 di as text %80s "{c -(}hline 80{c )-}"
{txt}234{com}.     {c )-}
{txt}235{com}.     di as text "{c -(}hline 80{c )-}"
{txt}236{com}.     di as text "Ratio = 1: methods equally accurate."
{txt}237{com}.     di as text "Ratio > 1: synthetic more accurate by that factor."
{txt}238{com}. 
.     * --- True AMEs for reference ---
.     di as text _n "{c -(}hline 80{c )-}"
{txt}239{com}.     di as text "TRUE AMEs BY CELL (for reference)"
{txt}240{com}.     di as text "{c -(}hline 80{c )-}"
{txt}241{com}.     forval c = 1/`ncells' {c -(}
{txt}242{com}.         local lbl : word `c' of `cell_label'
{txt}243{com}.         di as result %22s "`lbl'" %10.4f `res_trueame'[`c',1]
{txt}244{com}.     {c )-}
{txt}245{com}.     di as text "{c -(}hline 80{c )-}"
{txt}246{com}. 
.     return matrix mae     = `res_mae'
{txt}247{com}.     return matrix bias    = `res_bias'
{txt}248{com}.     return matrix dir     = `res_dir'
{txt}249{com}.     return matrix trueame = `res_trueame'
{txt}250{com}. 
. end
{txt}
{com}. 
. 
