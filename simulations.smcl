{com}. 
. 
. *===============================================================================
. * true_ame
. * Computes the true population AME for each DGP by Monte Carlo integration.
. * Uses a very large sample (N=500,000) to approximate the expectation
. * E[Lambda'(alpha + beta*D + gamma1*X1 + gamma2*X2 + delta*Z)]
. * The true AME = beta * E[Lambda'(eta)] where eta is the true linear index.
. *
. * UNCHANGED from the original Version 17 script. Does not call the
. * sensitivity package at all — pure Monte Carlo integration plus a
. * readback of the me_short_dgp1..4 globals set by sensitivity_dgp_combined.
. *===============================================================================
. 
. capture program drop true_ame
{txt}
{com}. program define true_ame
{txt}  1{com}. 
.     di as text _n "{c -(}hline 70{c )-}"
{txt}  2{com}.     di as text "TRUE POPULATION AME BY MONTE CARLO INTEGRATION"
{txt}  3{com}.     di as text "N = 500,000 draws from the true DGP"
{txt}  4{com}.     di as text "{c -(}hline 70{c )-}"
{txt}  5{com}. 
.     *---------------------------------------------------------------------------
.     * DGP 1
.     *---------------------------------------------------------------------------
.     di as text _n "DGP 1: No confounder"
{txt}  6{com}.     clear
{txt}  7{com}.     set obs 500000
{txt}  8{com}.     gen X1  = rnormal()
{txt}  9{com}.     gen X2  = rnormal()
{txt} 10{com}.     gen D   = (0.3*X1 + rnormal() > 0)
{txt} 11{com}.     gen eta = -0.5 + 0.5*D + 0.3*X1 + 0.2*X2
{txt} 12{com}.     gen lp  = invlogit(eta)
{txt} 13{com}.     gen lpd = lp * (1 - lp)
{txt} 14{com}.     qui sum lpd
{txt} 15{com}.     local true_ame1 = 0.5 * r(mean)
{txt} 16{com}.     di as result "  True AME (D) = " %8.4f `true_ame1'
{txt} 17{com}. 
.     *---------------------------------------------------------------------------
.     * DGP 2
.     *---------------------------------------------------------------------------
.     di as text _n "DGP 2: Weak confounder"
{txt} 18{com}.     clear
{txt} 19{com}.     set obs 500000
{txt} 20{com}.     gen X1  = rnormal()
{txt} 21{com}.     gen X2  = rnormal()
{txt} 22{com}.     gen D   = (0.3*X1 + rnormal() > 0)
{txt} 23{com}.     qui reg D X1 X2
{txt} 24{com}.     qui predict double Dr, resid
{txt} 25{com}.     qui sum Dr
{txt} 26{com}.     qui replace Dr = Dr / r(sd)
{txt} 27{com}.     gen Z   = 0.3*Dr + sqrt(1-0.09)*rnormal()
{txt} 28{com}.     drop Dr
{txt} 29{com}.     gen eta = -0.5 + 0.5*D + 0.3*X1 + 0.2*X2 + 0.2*Z
{txt} 30{com}.     gen lp  = invlogit(eta)
{txt} 31{com}.     gen lpd = lp * (1 - lp)
{txt} 32{com}.     qui sum lpd
{txt} 33{com}.     local true_ame2 = 0.5 * r(mean)
{txt} 34{com}.     di as result "  True AME (D) = " %8.4f `true_ame2'
{txt} 35{com}. 
.     *---------------------------------------------------------------------------
.     * DGP 3
.     *---------------------------------------------------------------------------
.     di as text _n "DGP 3: Strong confounder"
{txt} 36{com}.     clear
{txt} 37{com}.     set obs 500000
{txt} 38{com}.     gen X1  = rnormal()
{txt} 39{com}.     gen X2  = rnormal()
{txt} 40{com}.     gen D   = (0.3*X1 + rnormal() > 0)
{txt} 41{com}.     qui reg D X1 X2
{txt} 42{com}.     qui predict double Dr, resid
{txt} 43{com}.     qui sum Dr
{txt} 44{com}.     qui replace Dr = Dr / r(sd)
{txt} 45{com}.     gen Z   = 0.6*Dr + sqrt(1-0.36)*rnormal()
{txt} 46{com}.     drop Dr
{txt} 47{com}.     gen eta = -0.5 + 0.3*D + 0.3*X1 + 0.2*X2 + 0.8*Z
{txt} 48{com}.     gen lp  = invlogit(eta)
{txt} 49{com}.     gen lpd = lp * (1 - lp)
{txt} 50{com}.     qui sum lpd
{txt} 51{com}.     local true_ame3 = 0.3 * r(mean)
{txt} 52{com}.     di as result "  True AME (D) = " %8.4f `true_ame3'
{txt} 53{com}. 
.     *---------------------------------------------------------------------------
.     * DGP 4
.     *---------------------------------------------------------------------------
.     di as text _n "DGP 4: Zero true effect"
{txt} 54{com}.     clear
{txt} 55{com}.     set obs 500000
{txt} 56{com}.     gen X1  = rnormal()
{txt} 57{com}.     gen X2  = rnormal()
{txt} 58{com}.     gen D   = (0.3*X1 + rnormal() > 0)
{txt} 59{com}.     qui reg D X1 X2
{txt} 60{com}.     qui predict double Dr, resid
{txt} 61{com}.     qui sum Dr
{txt} 62{com}.     qui replace Dr = Dr / r(sd)
{txt} 63{com}.     gen Z   = 0.4*Dr + sqrt(1-0.16)*rnormal()
{txt} 64{com}.     drop Dr
{txt} 65{com}.     gen eta = -0.5 + 0.0*D + 0.3*X1 + 0.2*X2 + 0.8*Z
{txt} 66{com}.     gen lp  = invlogit(eta)
{txt} 67{com}.     gen lpd = lp * (1 - lp)
{txt} 68{com}.     qui sum lpd
{txt} 69{com}.     local true_ame4 = 0.0 * r(mean)   // exactly zero by construction
{txt} 70{com}.     di as result "  True AME (D) = " %8.4f `true_ame4'
{txt} 71{com}. 
.     *---------------------------------------------------------------------------
.     * Summary — short-model AMEs read from globals set by sensitivity_dgp_combined
.     *---------------------------------------------------------------------------
.     * Check globals are available
.     foreach g in me_short_dgp1 me_short_dgp2 me_short_dgp3 me_short_dgp4 {c -(}
{txt} 72{com}.         if "${c -(}`g'{c )-}" == "" {c -(}
{txt} 73{com}.             di as error "Global `g' not found — run sensitivity_dgp_combined first"
{txt} 74{com}.             exit 198
{txt} 75{com}.         {c )-}
{txt} 76{com}.     {c )-}
{txt} 77{com}. 
.     local sme1 = ${c -(}me_short_dgp1{c )-}
{txt} 78{com}.     local sme2 = ${c -(}me_short_dgp2{c )-}
{txt} 79{com}.     local sme3 = ${c -(}me_short_dgp3{c )-}
{txt} 80{com}.     local sme4 = ${c -(}me_short_dgp4{c )-}
{txt} 81{com}. 
.     di as text _n "{c -(}hline 70{c )-}"
{txt} 82{com}.     di as text "SUMMARY"
{txt} 83{com}.     di as text "{c -(}hline 70{c )-}"
{txt} 84{com}.     di as text %25s "DGP" %12s "True AME" %18s "Short-model AME" %12s "Bias"
{txt} 85{com}.     di as text "{c -(}hline 67{c )-}"
{txt} 86{com}.     di as result %25s "1 (No confounder)"        %12.4f `true_ame1' ///
>                  %18.4f `sme1' %12.4f (`sme1' - `true_ame1')
{txt} 87{com}.     di as result %25s "2 (Weak confounder)"      %12.4f `true_ame2' ///
>                  %18.4f `sme2' %12.4f (`sme2' - `true_ame2')
{txt} 88{com}.     di as result %25s "3 (Strong confounder)"    %12.4f `true_ame3' ///
>                  %18.4f `sme3' %12.4f (`sme3' - `true_ame3')
{txt} 89{com}.     di as result %25s "4 (Zero true effect)"     %12.4f `true_ame4' ///
>                  %18.4f `sme4' %12.4f (`sme4' - `true_ame4')
{txt} 90{com}.     di as text "{c -(}hline 67{c )-}"
{txt} 91{com}.     di as text "Note: Short-model AMEs are globals set by sensitivity_dgp_combined."
{txt} 92{com}.     di as text "Bias = Short-model AME - True AME."
{txt} 93{com}. 
. end
{txt}
{com}. 
. true_ame

